{
  "name": "ridgeline-studio",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "vp run typecheck && astro check && astro build",
    "check": "vp run fmt:check && vp run lint:check && vp run typecheck && vp run astro:check && vp run knip:check",
    "astro:check": "astro check",
    "knip:check": "knip",
    "lint:check": "vp check --no-fmt",
    "check:fix": "vp run fmt:fix --cache && vp check --fix",
    "accessibility:check": "vp run build && vp run preview",
    "dev": "astro dev --host",
    "fmt:check": "prettier --check .",
    "fmt:fix": "prettier --write .",
    "preview": "astro preview",
    "typecheck": "tsrs --noEmit --fast",
    "deploy:prod": "vp run check && vercel --prod",
    "deploy:dev": "vp run check && vercel"
  },
  "dependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/ts-plugin": "1.10.12",
    "@fontsource-variable/inter": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.2",
    "class-variance-authority": "0.7.1",
    "cnfast": "catalog:",
    "tailwindcss": "4.3.3",
    "tsrs": "catalog:"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "knip": "6.44.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "prettier-plugin-tailwindcss": "0.0.0-insiders.5b27f94",
    "typescript": "6.0.3",
    "vercel": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
