{
  "name": "ridgeline-studio",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "astro build",
    "check:fix": "vp run fmt:fix --cache && vp check --fix",
    "dev": "astro dev --host",
    "fmt:check": "prettier --check .",
    "fmt:fix": "prettier --write .",
    "preview": "astro preview"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.2",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "prettier-plugin-tailwindcss": "0.0.0-insiders.5b27f94",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
