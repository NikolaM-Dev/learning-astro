---
import NavigationButton from "./NavigationButton.astro";

import CrossMarkIcon from "../assets/cross-mark.svg";
import Logo from "../assets/logo.svg";
import MenuIcon from "../assets/menu.svg";
---

<nav class="border-b border-b-border-default px-5 py-2.5 md:flex md:justify-center md:px-10 md:py-5">
  <div class="max-w-desktop md:flex-1">
    <!-- Mobile -->
    <div class="flex items-center justify-between md:hidden">
      <Logo />
      <button
        class="btn-menu group grid size-4 place-items-center"
        aria-controls="main-menu"
        aria-expanded="false"
      >
        <MenuIcon class="group-aria-expanded:hidden" />
        <CrossMarkIcon class="not-group-aria-expanded:hidden" />
      </button>
    </div>

    <div
      aria-expanded="false"
      class="mobile-menu hidden pt-2.5 aria-expanded:block"
    >
      <ul class="flex flex-col gap-2">
        <li class="text-label-m text-text-secondary">
          Product
        </li>
        <li class="text-label-m text-text-secondary">
          Pricing
        </li>
        <li class="text-label-m text-text-secondary">
          Stories
        </li>
        <li class="text-label-m text-text-secondary">
          Help
        </li>
        <li class="text-label-m text-text-secondary">
          Sign in
        </li>
        <li class="text-label-m text-brand-primary">
          Start free
        </li>
      </ul>
    </div>

    <!-- Desktop -->
    <div class="hidden items-center justify-between md:flex">
      <ul class="flex gap-9">
        <li class="text-label-m text-text-secondary">
          Product
        </li>
        <li class="text-label-m text-text-secondary">
          Pricing
        </li>
        <li class="text-label-m text-text-secondary">
          Stories
        </li>
        <li class="text-label-m text-text-secondary">
          Help
        </li>
      </ul>

      <div class="flex items-center gap-5">
        <p class="text-label-m text-text-primary">
          Sign in
        </p>
        <NavigationButton title="Start free" />
      </div>
    </div>
  </div>
</nav>
