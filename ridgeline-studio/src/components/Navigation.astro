---
import NavigationButton from "./NavigationButton.astro";

import Logo from "../assets/logo.svg";
import Menu from "../assets/menu.svg";
---

<nav class="border-b border-b-border-default px-5 py-2.5 md:flex md:justify-center md:px-10 md:py-5">
  <div class="max-w-desktop md:flex-1">
    <!-- Mobile -->
    <div class="flex items-center justify-between md:hidden">
      <Logo />
      <Menu />
    </div>

    <!-- Desktop -->
    <div class="hidden items-center justify-between md:flex">
      <ul class="flex gap-9">
        <li class="text-label-m leading-label-m font-label-m text-text-seconday">
          Product
        </li>
        <li class="text-label-m leading-label-m font-label-m text-text-seconday">
          Pricing
        </li>
        <li class="text-label-m leading-label-m font-label-m text-text-seconday">
          Stories
        </li>
        <li class="text-label-m leading-label-m font-label-m text-text-seconday">
          Help
        </li>
      </ul>

      <div class="flex items-center gap-5">
        <p class="text-label-m leading-label-m font-label-m text-text-primary">
          Sign in
        </p>
        <NavigationButton title="Start free" />
      </div>
    </div>
  </div>
</nav>
