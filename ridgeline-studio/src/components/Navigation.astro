---
import Button from "@/components/Button.astro";

import CrossMarkIcon from "@/assets/cross-mark.svg";
import Logo from "@/assets/logo.svg";
import MenuIcon from "@/assets/menu.svg";
---

<nav class="border-b border-b-border-default px-5 py-2.5 md:px-10 md:py-5">
  <div class="mx-auto w-full max-w-desktop">
    <!-- Mobile -->
    <div class="flex items-center justify-between md:hidden">
      <Logo />
      <button
        class="btn-menu group grid size-4 place-items-center"
        aria-controls="main-menu"
        aria-expanded="false"
      >
        <MenuIcon class="group-aria-expanded:hidden" />
        <CrossMarkIcon class="not-group-aria-expanded:hidden" />
      </button>
    </div>

    <div id="main-menu" class="mobile-menu hidden pt-2.5">
      <ul class="flex flex-col gap-2">
        <li>
          <a href="#" class="text-label-m text-text-secondary">
            Product
          </a>
        </li>
        <li>
          <a href="#" class="text-label-m text-text-secondary">
            Pricing
          </a>
        </li>
        <li>
          <a href="#" class="text-label-m text-text-secondary">
            Stories
          </a>
        </li>
        <li>
          <a href="#" class="text-label-m text-text-secondary">
            Help
          </a>
        </li>
        <li>
          <a href="#" class="text-label-m text-text-secondary">
            Sign in
          </a>
        </li>
        <li>
          <a href="#" class="text-label-m text-brand-primary">
            Start free
          </a>
        </li>
      </ul>
    </div>

    <!-- Desktop -->
    <div class="hidden items-center justify-between md:flex">
      <ul class="flex gap-9">
        <li>
          <a href="#" class="text-label-m text-text-secondary">
            Product
          </a>
        </li>
        <li>
          <a href="#" class="text-label-m text-text-secondary">
            Pricing
          </a>
        </li>
        <li>
          <a href="#" class="text-label-m text-text-secondary">
            Stories
          </a>
        </li>
        <li>
          <a href="#" class="text-label-m text-text-secondary">
            Help
          </a>
        </li>
      </ul>

      <div class="flex items-center gap-5">
        <Button size="small" variant="ghost" title="Sign in" />
        <Button size="small" title="Stay free" />
      </div>
    </div>
  </div>
</nav>
