---
const { feature } = Astro.props;
const Icon = feature.icon;
---

<article class="flex flex-col gap-4 rounded-3xl bg-white p-7 shadow-card">
  <header class="flex size-12 items-center justify-center rounded-[14px] bg-brand-soft">
    <Icon />
  </header>

  <main class="flex flex-col gap-2">
    <h3 class="text-heading-s leading-body-s font-heading-s text-text-primary">
      {feature.title}
    </h3>
    <p class="text-body-m leading-body-m font-body-m text-text-seconday">
      {feature.description}
    </p>
  </main>
</article>
