---
import Badge from "./Badge.astro";
import ButtonPrimary from "./ButtonPrimary.astro";
import ButtonSecondary from "./ButtonSecondary.astro";
import Headline from "./Headline.astro";
---

<section class="flex flex-col gap-6">
  <Badge title="New · Shared trail maps" />
  <Headline />

  <div class="flex gap-3">
    <ButtonPrimary title="Start free" />
    <ButtonSecondary title="Watch the tour" />
  </div>

  <p class="font-body-s leading-body-s text-text-seconday">Free for clubs of up to ten people</p>
</section>
