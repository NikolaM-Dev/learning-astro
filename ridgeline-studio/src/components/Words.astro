---
import Badge from "@/components/Badge.astro";
import Button from "@/components/Button.astro";
import Headline from "@/components/Headline.astro";
---

<section class="flex flex-col gap-6 md:items-center lg:items-start">
  <Badge title="New · Shared trail maps" />
  <Headline />

  <div class="flex gap-3 md:justify-center lg:justify-start">
    <Button title="Start free" />
    <Button variant="secondary" title="Watch the tour" />
  </div>

  <p class="text-body-s text-text-secondary">
    Free for clubs of up to ten people
  </p>
</section>
