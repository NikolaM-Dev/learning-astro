---
import Badge from "./Badge.astro";
import ButtonPrimary from "./ButtonPrimary.astro";
import ButtonSecondary from "./ButtonSecondary.astro";
import Headline from "./Headline.astro";
---

<section class="flex flex-col gap-6 md:items-center lg:items-start">
  <Badge title="New · Shared trail maps" />
  <Headline />

  <div class="flex gap-3 md:justify-center">
    <ButtonPrimary title="Start free" />
    <ButtonSecondary title="Watch the tour" />
  </div>

  <p class="text-body-s leading-body-s font-body-s text-text-secondary">
    Free for clubs of up to ten people
  </p>
</section>
