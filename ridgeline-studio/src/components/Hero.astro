---
import Words from "./Words.astro";

import MobilePicture from "@assets/mobile-picture.svg";
import DesktopPicture from "@assets/desktop-picture.svg";
---

<section class="flex justify-center px-5 py-11 md:px-10 md:py-22">
  <div class="flex max-w-desktop flex-col gap-8 lg:flex-row lg:gap-18">
    <Words />

    <div class="flex justify-center lg:hidden">
      <MobilePicture />
    </div>
    <div class="hidden justify-center lg:flex">
      <DesktopPicture />
    </div>
  </div>
</section>
