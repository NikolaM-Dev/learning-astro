---
import FeatureCard from "./FeatureCard.astro";

import LayersIcon from "../assets/layers.svg";
import DownloadIcon from "../assets/download.svg";
import ClockIcon from "../assets/clock.svg";

const features = [
  {
    icon: LayersIcon,
    title: "Routes everyone can edit",
    description:
      "Draw a route once and let the whole club adjust it. Every change is kept, so nothing is lost.",
  },
  {
    icon: DownloadIcon,
    title: "Ready without signal",
    description:
      "Maps, notes and meeting points are saved to each phone before you leave the car park.",
  },
  {
    icon: ClockIcon,
    title: "Plans that fit the day",
    description:
      "Sunrise, daylight and pace are worked out for you, with a turnaround time you can trust.",
  },
];
---

<section class="flex justify-center bg-surface-page px-5 py-11 md:px-10 md:py-22">
  <div class="flex max-w-desktop flex-col gap-12">
    <header class="flex flex-col gap-3 text-center">
      <h2 class="text-heading-l text-text-primary">
        Everything the day needs
      </h2>
      <p class="text-body-l text-text-secondary">
        Three things walking clubs told us they were tired of doing by hand.
      </p>
    </header>

    <main class="flex justify-center">
      <div class="grid gap-6 md:max-w-fit md:grid-cols-2 lg:grid-cols-3">
        {features.map((feature) => (
          <FeatureCard feature={feature} />
        ))}
      </div>
    </main>
  </div>
</section>
