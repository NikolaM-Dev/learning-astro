---
import ButtonPrimary from "./ButtonPrimary.astro";
---

<section class="px-5 pb-11 md:flex md:justify-center md:pb-22">
  <article class="flex flex-col gap-6 rounded-[28px] bg-brand-soft p-7 md:max-w-desktop md:flex-1 md:flex-row md:items-center md:justify-center md:gap-0 md:p-14">
    <header class="flex flex-col gap-2 md:flex-1">
      <h2 class="text-heading-l leading-heading-l font-heading-l text-text-primary">
        Take the next walk off the group chat
      </h2>
      <p class="text-body-l leading-body-l font-body-l text-text-seconday">
        Set up your club in a couple of minutes. No card needed.
      </p>
    </header>

    <main>
      <ButtonPrimary title="Start free" />
    </main>
  </article>
</section>
