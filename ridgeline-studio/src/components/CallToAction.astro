---
import ButtonPrimary from "./ButtonPrimary.astro";
---

<section class="px-5 pb-11">
  <article class="bg-brand-soft p-7 flex flex-col gap-6 rounded-[28px]">
    <header>
      <h2 class="text-text-primary text-heading-l leading-heading-l font-heading-l">
        Take the next walk off the group chat
      </h2>
      <p class="text-text-seconday leading-body-l font-body-l text-body-l">
        Set up your club in a couple of minutes. No card needed.
      </p>
    </header>
    <main>
      <ButtonPrimary title="Start free" />
    </main>
  </article>
</section>
