---
import Stat from "@/components/Stat.astro";

const stats = [
  {
    title: "4,200",
    description: "Clubs planning together",
  },
  {
    title: "38k",
    description: "Routes shared",
  },
  {
    title: "96%",
    description: "Walks finished on time",
  },
  {
    title: "12",
    description: "Languages",
  },
];
---

<section class="bg-brand-primary px-5 py-8 md:px-10 md:py-16">
  <div class="mx-auto flex w-full max-w-desktop flex-col gap-8 md:flex-row md:justify-center">
    {stats.map((stat) => (
      <Stat stat={stat} />
    ))}
  </div>
</section>
